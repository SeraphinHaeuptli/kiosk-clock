# Optional. An HTTP endpoint reporting what is currently playing.
# Leave unset and the bar shows "nothing playing".
#
# Expected response shape:
#   { "title": "Song name", "artist": "Artist", "playing": true }
#
# "artist" is optional. "playing" may also be given as "isPlaying", or
# inferred from a "status" field. A playerctl or MPRIS wrapper running on
# whatever machine is playing the audio is the usual source.
#
# This is the build-time default; it can be overridden per device in
# Settings -> now playing -> endpoint.
EXPO_PUBLIC_NOW_PLAYING_ENDPOINT=
